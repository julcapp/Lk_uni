{
  "name": "lk-registration-backend",
  "version": "1.0.0",
  "description": "Регистрация в личном кабинете: телефон (звонок-подтверждение через SMSC.ru) + email (@yuodomen.ru) + OAuth (VK/MAX/Telegram/SberID)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "knex --knexfile knexfile.js migrate:latest",
    "db:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "db:seed": "knex --knexfile knexfile.js seed:run",
    "db:check": "node scripts/check-postgres.js",
    "db:test": "node tests/postgres-migration.test.js",
    "auth:test": "node tests/auth-core.integration.test.js",
    "project:test": "node tests/project-creation.integration.test.js",
    "acceptance:smoke": "node tests/acceptance-smoke.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.4"
  }
}
