# --- Сервер ---
PORT=3000
BASE_URL=https://your-domain.ru

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lk_registration

# --- SMSC.ru (звонок-подтверждение) ---
SMSC_LOGIN=ваш_логин_smsc
SMSC_PASSWORD=ваш_пароль_или_api_key
# таймаут ожидания ввода кода пользователем, сек
PHONE_CODE_TTL_SECONDS=180

# --- Email (SMTP для отправки кода подтверждения) ---
SMTP_HOST=smtp.yuodomen.ru
SMTP_PORT=587
SMTP_USER=noreply@yuodomen.ru
SMTP_PASSWORD=
SMTP_FROM="AI-Практик <noreply@yuodomen.ru>"
EMAIL_CODE_TTL_SECONDS=600
# домен, из которого разрешена регистрация по email
ALLOWED_EMAIL_DOMAIN=yuodomen.ru

# --- JWT (сессия пользователя) ---
JWT_ACCESS_SECRET=замените_на_случайную_строку
JWT_REFRESH_SECRET=замените_на_случайную_строку_2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OAuth провайдеры (заполняются по мере подключения) ---
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://your-domain.ru/auth/vk/callback

MAX_CLIENT_ID=
MAX_CLIENT_SECRET=
MAX_REDIRECT_URI=https://your-domain.ru/auth/max/callback

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

SBERID_CLIENT_ID=
SBERID_CLIENT_SECRET=
SBERID_REDIRECT_URI=https://your-domain.ru/auth/sberid/callback
